/** Balam · integración institucional. No contiene credenciales ni resultados de alumnos. */
const BALAM_CONFIG = {courseId:'889024738153',domain:'jaliscoedu.mx',sourceRef:'2f78520e13e84c1bc48d38253aa12b45605ad32c',repo:'soybran07/aventura-matematica'};
function props_(){return PropertiesService.getScriptProperties()}
function api_(path,method,body){const response=UrlFetchApp.fetch('https://classroom.googleapis.com/v1/'+path,{method:method||'get',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},contentType:'application/json',payload:body===undefined?undefined:JSON.stringify(body),muteHttpExceptions:true});const status=response.getResponseCode();if(status<200||status>=300)throw Error('Classroom respondió '+status+'. Revisa permisos y configuración de la actividad.');return JSON.parse(response.getContentText()||'{}')}
function list_(path,field){let all=[],token='';do{const data=api_(path+(path.indexOf('?')<0?'?':'&')+'pageSize=100'+(token?'&pageToken='+encodeURIComponent(token):''));all=all.concat(data[field]||[]);token=data.nextPageToken||''}while(token);return all}
function owner_(){const active=Session.getActiveUser().getEmail().toLowerCase(),effective=Session.getEffectiveUser().getEmail().toLowerCase();if(!active||active!==effective||!active.endsWith('@'+BALAM_CONFIG.domain))throw Error('Esta función solo la ejecuta el profesor propietario desde Apps Script.');api_('courses/'+BALAM_CONFIG.courseId+'/teachers/me');return active}
/** Ejecutar en el editor una vez. Crea cinco tareas EN BORRADOR del mismo proyecto. */
function configurarClassroom(){const email=owner_();props_().setProperty('OWNER',email);const titles=['Sumas y restas sin reagrupación','Sumas llevando','Restas con préstamo','Restas con ceros y comprobación','Problemas de varios pasos'];let mapping=JSON.parse(props_().getProperty('TASKS')||'{}');const existing=list_('courses/'+BALAM_CONFIG.courseId+'/courseWork','courseWork');for(let w=0;w<5;w++){if(mapping[w])continue;const title='Balam · Evaluación '+(w+1)+'/5 · '+titles[w];const found=existing.find(x=>x.title===title&&x.associatedWithDeveloper);const task=found||api_('courses/'+BALAM_CONFIG.courseId+'/courseWork','post',{title,description:'Resuelve el mundo de Balam usando tu correo institucional. La nota sobre 100 representa aciertos al primer intento entre seis retos. Los reintentos y las pistas se registran aparte. El profesor revisa el cuaderno y confirma la calificación.',workType:'ASSIGNMENT',state:'DRAFT',maxPoints:100});mapping[w]=task.id;props_().setProperty('TASKS',JSON.stringify(mapping))}console.log('Cinco tareas listas en borrador. Despliega la aplicación web para tu dominio y luego ejecuta publicarTareas.');return {tasks:mapping,courseId:BALAM_CONFIG.courseId}}
/** Ejecutar después de desplegar. Publica las cinco tareas con enlaces autenticados. */
function publicarTareas(){owner_();const url='https://script.google.com/a/macros/jaliscoedu.mx/s/AKfycbwDWLhOth-b33H_Ugudxo5X6hXFUEmdK30ZkNNhCQpLuH39ms8O6EydHyJ2Q8EtF4QJ/exec';if(!url||!url.endsWith('/exec'))throw Error('Primero implementa como aplicación web institucional.');const tasks=JSON.parse(props_().getProperty('TASKS')||'{}');for(let w=0;w<5;w++){if(!tasks[w])throw Error('Ejecuta configurarClassroom.');api_('courses/'+BALAM_CONFIG.courseId+'/courseWork/'+tasks[w]+'?updateMask=state,materials','patch',{state:'PUBLISHED',materials:[{link:{url:url+'?nivel='+(w+1),title:'Jugar y registrar resultado · Mundo '+(w+1)}}]})}console.log('Las cinco tareas están publicadas. Las notas se guardarán como borrador para revisión docente.');return {url}}
function identity_(){const email=Session.getActiveUser().getEmail().toLowerCase();if(!email||!email.endsWith('@'+BALAM_CONFIG.domain))throw Error('Abre el juego con tu correo institucional. No pudimos verificar tu identidad.');const owner=props_().getProperty('OWNER');if(!owner)throw Error('El profesor debe completar la configuración.');if(email===owner)return {id:'teacher-preview',teacher:true};const cached=CacheService.getScriptCache().get('roster:'+email);if(cached)return{id:cached,teacher:false};const roster=list_('courses/'+BALAM_CONFIG.courseId+'/students','students'),student=roster.find(s=>s.profile&&s.profile.emailAddress&&s.profile.emailAddress.toLowerCase()===email);if(!student)throw Error('Tu cuenta institucional todavía no está inscrita en esta clase. Pide al profesor el acceso.');CacheService.getScriptCache().put('roster:'+email,student.userId,300);return{id:student.userId,teacher:false}}
function world_(w){w=Number(w);if(!Number.isInteger(w)||w<0||w>4)throw Error('Mundo inválido.');return w}
function stateKey_(who,w){return 'RESULT:'+who.id+':'+w}
function readState_(who,w,route){const key=stateKey_(who,w),raw=props_().getProperty(key);if(raw)return JSON.parse(raw);if(!['apoyo','practica'].includes(route))throw Error('Ruta inválida.');return{route,done:0,records:[],pending:{attempts:0,hints:0,correct:false},gradeStatus:'pending',updatedAt:new Date().toISOString()}}
function persist_(who,w,s){s.updatedAt=new Date().toISOString();props_().setProperty(stateKey_(who,w),JSON.stringify(s))}
function safeState_(s,who){return{route:s.route,done:s.done,records:s.records.map(r=>({code:r.code,tries:Math.max(0,r.attempts-1),hints:r.hints})),pending:{tries:Math.max(0,s.pending.attempts-(s.pending.correct?1:0)),hints:s.pending.hints},started:true,teacherPreview:who.teacher,gradeStatus:s.gradeStatus,grade:s.grade===undefined?null:s.grade}}
function locked_(fn){const lock=LockService.getScriptLock();lock.waitLock(20000);try{return fn()}finally{lock.releaseLock()}}
function iniciarJuego(w,route){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);persist_(who,w,s);return safeState_(s,who)})}
function sequence_(s,route,index){if(s.route!==route)throw Error('Continúa con la ruta inicial de esta evaluación. El profesor puede reiniciarla si necesitas otra.');if(index!==s.done||index<0||index>5)throw Error('Actualiza el juego para recuperar tu progreso.');}
function registrarRespuesta(w,route,index,value,check){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);sequence_(s,route,index);if(s.pending.correct)return{correct:true,state:safeState_(s,who)};if(!Number.isInteger(value)||value<0||(w===3&&(!Number.isInteger(check)||check<0)))throw Error('Respuesta inválida.');const p=getProblem(w,index,s.route);s.pending.attempts++;s.pending.correct=value===p.answer&&(w!==3||check===p.check);persist_(who,w,s);return{correct:s.pending.correct,state:safeState_(s,who)}})}
function usarPista(w,route,index){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);sequence_(s,route,index);s.pending.hints=1;persist_(who,w,s);return{hint:getProblem(w,index,s.route).hint,state:safeState_(s,who)}})}
function syncGrade_(who,w,s){if(who.teacher){s.gradeStatus='teacher-preview';return}const tasks=JSON.parse(props_().getProperty('TASKS')||'{}'),task=tasks[w];if(!task)throw Error('Falta la tarea de este mundo.');const submissions=list_('courses/'+BALAM_CONFIG.courseId+'/courseWork/'+task+'/studentSubmissions?userId='+encodeURIComponent(who.id),'studentSubmissions');if(submissions.length!==1)throw Error('No se encontró una entrega única para tu cuenta.');api_('courses/'+BALAM_CONFIG.courseId+'/courseWork/'+task+'/studentSubmissions/'+submissions[0].id+'?updateMask=draftGrade','patch',{draftGrade:s.grade});s.gradeStatus='draft-sent'}
function avanzarReto(w,route,index){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);if(index===s.done-1)return safeState_(s,who);sequence_(s,route,index);if(!s.pending.correct)throw Error('Resuelve el reto antes de avanzar.');s.records.push({code:getProblem(w,index,s.route).code,attempts:s.pending.attempts,hints:s.pending.hints});s.done++;s.pending={attempts:0,hints:0,correct:false};if(s.done===6){s.grade=Math.round(s.records.filter(r=>r.attempts===1).length/6*10000)/100;s.gradeStatus='pending-sync';persist_(who,w,s);try{syncGrade_(who,w,s)}catch(e){s.gradeStatus='pending-sync'}}persist_(who,w,s);return safeState_(s,who)})}
function reenviarCalificacion(w){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,'apoyo');if(s.done!==6)throw Error('Primero termina el mundo.');syncGrade_(who,w,s);persist_(who,w,s);return safeState_(s,who)})}
function fuente_(file){const key='asset:'+BALAM_CONFIG.sourceRef+':'+file;const cache=CacheService.getScriptCache(),hit=cache.get(key);if(hit)return hit;const r=UrlFetchApp.fetch('https://raw.githubusercontent.com/'+BALAM_CONFIG.repo+'/'+BALAM_CONFIG.sourceRef+'/sumas/'+file,{muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('No se pudieron cargar los archivos del juego.');const text=r.getContentText();if(text.length<90000)cache.put(key,text,600);return text}
function doGet(e){try{identity_();const w=Math.max(1,Math.min(5,Number(e&&e.parameter&&e.parameter.nivel)||1));let html=fuente_('index.html').replace(/<link rel="stylesheet"[^>]+>/,'<style>'+fuente_('estilo.css')+'</style>').replace(/<script src="datos.js"><\/script>/,'<script>'+fuente_('datos.js')+'</script>').replace(/<script src="juego.js[^\"]*"><\/script>/,'<script>'+CLASSROOM_BRIDGE+'\n'+REMOTE_GAME+'</script>');html=html.replace('Sin cuentas, anuncios ni envío de calificaciones. Progreso en este navegador. En equipos compartidos comienza una nueva partida.','Evaluación con cuenta institucional. Las notas se envían a Classroom para revisión del profesor.');html=html.replace('<head>','<head><base target="_top"><script>window.BALAM_WORLD='+w+';</script>');return HtmlService.createHtmlOutput(html).setTitle('Balam · Evaluación institucional')}catch(err){return HtmlService.createHtmlOutput('<h2>Acceso institucional a Balam</h2><p>'+String(err.message).replace(/[<>&]/g,' ')+'</p><p>Vuelve a abrir el enlace de tu tarea con la cuenta de la escuela.</p>')}}

