const BALAM_CONFIG = {courseId:'889024738153',domain:'jaliscoedu.mx',sourceRef:'f42388b9c1f9a8321a48bac2e480d987d50fd923',repo:'soybran07/aventura-matematica'};
function props_(){return PropertiesService.getScriptProperties()}
function api_(path,method,body){const response=UrlFetchApp.fetch('https://classroom.googleapis.com/v1/'+path,{method:method||'get',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},contentType:'application/json',payload:body===undefined?undefined:JSON.stringify(body),muteHttpExceptions:true});const status=response.getResponseCode();if(status<200||status>=300)throw Error('Classroom respondió '+status+': '+(JSON.parse(response.getContentText()||'{}').error||{}).message);return JSON.parse(response.getContentText()||'{}')}
function list_(path,field){let all=[],token='';do{const data=api_(path+(path.indexOf('?')<0?'?':'&')+'pageSize=100'+(token?'&pageToken='+encodeURIComponent(token):''));all=all.concat(data[field]||[]);token=data.nextPageToken||''}while(token);return all}
function owner_(){const active=Session.getActiveUser().getEmail().toLowerCase(),effective=Session.getEffectiveUser().getEmail().toLowerCase();if(!active||active!==effective||!active.endsWith('@'+BALAM_CONFIG.domain))throw Error('Esta función solo la ejecuta el profesor propietario desde Apps Script.');api_('courses/'+BALAM_CONFIG.courseId+'/teachers/me');return active}
/** Ejecutar en el editor una vez. Crea cinco tareas EN BORRADOR del mismo proyecto. */
function configurarClassroom(){const email=owner_();props_().setProperty('OWNER',email);const titles=['Sumas y restas sin reagrupación','Sumas llevando','Restas con préstamo','Restas con ceros y comprobación','Problemas de varios pasos','El templo de los números','La ruta del número secreto'];let mapping=JSON.parse(props_().getProperty('TASKS')||'{}');const existing=list_('courses/'+BALAM_CONFIG.courseId+'/courseWork','courseWork');for(let w=0;w<7;w++){if(mapping[w])continue;const title=w<5?'Balam · Evaluación '+(w+1)+'/5 · '+titles[w]:'Balam · Juego '+(w-4)+' · '+titles[w];const found=existing.find(x=>x.title===title&&x.associatedWithDeveloper);const task=found||api_('courses/'+BALAM_CONFIG.courseId+'/courseWork','post',{title,description:'Resuelve el mundo de Balam usando tu correo institucional. La nota sobre 100 representa aciertos al primer intento entre seis retos. Los reintentos y las pistas se registran aparte. El profesor revisa el cuaderno y confirma la calificación.',workType:'ASSIGNMENT',state:'DRAFT',maxPoints:100});mapping[w]=task.id;props_().setProperty('TASKS',JSON.stringify(mapping))}console.log('Siete tareas listas en borrador. Despliega la aplicación web para tu dominio y luego ejecuta publicarTareas.');return {tasks:mapping,courseId:BALAM_CONFIG.courseId}}
/** Ejecutar después de desplegar. Publica las cinco tareas con enlaces autenticados. */
function publicarTareas(){owner_();const url='https://script.google.com/a/macros/jaliscoedu.mx/s/AKfycbwDWLhOth-b33H_Ugudxo5X6hXFUEmdK30ZkNNhCQpLuH39ms8O6EydHyJ2Q8EtF4QJ/exec';if(!url||!url.endsWith('/exec'))throw Error('Primero implementa como aplicación web institucional.');const tasks=JSON.parse(props_().getProperty('TASKS')||'{}');for(let w=0;w<7;w++){if(!tasks[w])throw Error('Ejecuta configurarClassroom.');api_('courses/'+BALAM_CONFIG.courseId+'/courseWork/'+tasks[w]+'?updateMask=state,description','patch',{state:'PUBLISHED',description:'JUGAR Y REGISTRAR CALIFICACIÓN: '+url+'?nivel='+(w+1)+'\n\nRescata a Luna: salta entre plataformas, supera guardianes y resuelve '+totalRetos(w)+' retos con tu correo institucional inscrito en esta clase. Conserva las operaciones en tu cuaderno. Nota base sobre 100 = aciertos al primer intento / '+totalRetos(w)+' × 100. Si te equivocas, puedes encontrar hasta tres monedas mayas: cada una suma +0.5 sobre 10 (+5/100), máximo +15/100 y nota total máxima de 100. Los movimientos, caídas y enemigos no restan puntos. Las preguntas pausan la acción. También hay movimiento con ayuda. Al completar los retos, espera el mensaje de envío a Classroom; las monedas posteriores actualizan el bono. El profesor revisará y devolverá tu nota.'})}console.log('Las siete tareas están publicadas. Las notas se guardarán como borrador para revisión docente.');return {url}}
function identity_(){const email=Session.getActiveUser().getEmail().toLowerCase();if(!email||!email.endsWith('@'+BALAM_CONFIG.domain))throw Error('Abre el juego con tu correo institucional. No pudimos verificar tu identidad.');const owner=props_().getProperty('OWNER');if(!owner)throw Error('El profesor debe completar la configuración.');if(email===owner)return {id:'teacher-preview',teacher:true};const cached=CacheService.getScriptCache().get('roster:'+email);if(cached)return{id:cached,teacher:false};const roster=list_('courses/'+BALAM_CONFIG.courseId+'/students','students'),student=roster.find(s=>s.profile&&s.profile.emailAddress&&s.profile.emailAddress.toLowerCase()===email);if(!student)throw Error('Tu cuenta institucional todavía no está inscrita en esta clase. Pide al profesor el acceso.');CacheService.getScriptCache().put('roster:'+email,student.userId,300);return{id:student.userId,teacher:false}}
function world_(w){w=Number(w);if(!Number.isInteger(w)||w<0||w>11)throw Error('Mundo inválido.');return w}
function stateKey_(who,w){return 'RESULT:'+who.id+':'+w}
function readState_(who,w,route){const key=stateKey_(who,w),raw=props_().getProperty(key);if(raw){const s=JSON.parse(raw);s.coins=s.coins||[];return s;}if(!rutas(w).includes(route))throw Error('Ruta inválida.');return{route,done:0,records:[],pending:{attempts:0,hints:0,correct:false},coins:[],gradeStatus:'pending',updatedAt:new Date().toISOString()}}
function persist_(who,w,s){s.updatedAt=new Date().toISOString();props_().setProperty(stateKey_(who,w),JSON.stringify(s))}
function safeState_(s,who){return{route:s.route,done:s.done,records:s.records.map(r=>({code:r.code,tries:Math.max(0,r.attempts-1),hints:r.hints})),pending:{tries:Math.max(0,s.pending.attempts-(s.pending.correct?1:0)),hints:s.pending.hints},coins:s.coins||[],baseGrade:s.baseGrade===undefined?null:s.baseGrade,bonus:(s.coins||[]).length*5,started:true,teacherPreview:who.teacher,gradeStatus:s.gradeStatus,grade:s.grade===undefined?null:s.grade}}
function locked_(fn){const lock=LockService.getScriptLock();lock.waitLock(20000);try{return fn()}finally{lock.releaseLock()}}
function iniciarJuego(w,route){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);persist_(who,w,s);return safeState_(s,who)})}
function sequence_(s,route,index,w){if(s.route!==route)throw Error('Continúa con la ruta inicial de esta evaluación. El profesor puede reiniciarla si necesitas otra.');if(index!==s.done||index<0||index>=totalRetos(w))throw Error('Actualiza el juego para recuperar tu progreso.');}
function registrarRespuesta(w,route,index,value,check){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);sequence_(s,route,index,w);if(s.pending.correct)return{correct:true,state:safeState_(s,who)};const p=getProblem(w,index,s.route);if(!respuestaValida(p,value,check))throw Error('Respuesta inválida.');s.pending.attempts++;s.pending.correct=respuestaCorrecta(p,value,check);persist_(who,w,s);return{correct:s.pending.correct,state:safeState_(s,who)}})}
function usarPista(w,route,index){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);sequence_(s,route,index,w);s.pending.hints=1;persist_(who,w,s);return{hint:getProblem(w,index,s.route).hint,state:safeState_(s,who)}})}
function syncGrade_(who,w,s){if(who.teacher){s.gradeStatus='teacher-preview';return}const tasks=JSON.parse(props_().getProperty('TASKS')||'{}'),task=tasks[w];if(!task)throw Error('Falta la tarea de este mundo.');const submissions=list_('courses/'+BALAM_CONFIG.courseId+'/courseWork/'+task+'/studentSubmissions?userId='+encodeURIComponent(who.id),'studentSubmissions');if(submissions.length!==1)throw Error('No se encontró una entrega única para tu cuenta.');api_('courses/'+BALAM_CONFIG.courseId+'/courseWork/'+task+'/studentSubmissions/'+submissions[0].id+'?updateMask=draftGrade','patch',{draftGrade:s.grade});s.gradeStatus='draft-sent'}
function avanzarReto(w,route,index){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,route);if(index===s.done-1)return safeState_(s,who);sequence_(s,route,index,w);if(!s.pending.correct)throw Error('Resuelve el reto antes de avanzar.');s.records.push({code:getProblem(w,index,s.route).code,attempts:s.pending.attempts,hints:s.pending.hints});s.done++;s.pending={attempts:0,hints:0,correct:false};if(s.done===totalRetos(w)){calculateGrade_(w,s);s.gradeStatus='pending-sync';persist_(who,w,s);try{syncGrade_(who,w,s)}catch(e){s.gradeStatus='pending-sync'}}persist_(who,w,s);return safeState_(s,who)})}
function reenviarCalificacion(w){return locked_(()=>{w=world_(w);const who=identity_(),s=readState_(who,w,'apoyo');if(s.done!==totalRetos(w))throw Error('Primero termina el mundo.');calculateGrade_(w,s);syncGrade_(who,w,s);persist_(who,w,s);return safeState_(s,who)})}
function fuente_(file){const key='asset:'+BALAM_CONFIG.sourceRef+':'+file;const cache=CacheService.getScriptCache(),hit=cache.get(key);if(hit)return hit;const r=UrlFetchApp.fetch('https://raw.githubusercontent.com/'+BALAM_CONFIG.repo+'/'+BALAM_CONFIG.sourceRef+'/sumas/'+file,{muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('No se pudieron cargar los archivos del juego.');const text=r.getContentText();if(text.length<90000)cache.put(key,text,600);return text}
function doGet(e){if(Number(e&&e.parameter&&e.parameter.nivel)>=8)return doGetMultiplicacion_(e);try{identity_();const w=Math.max(1,Math.min(7,Number(e&&e.parameter&&e.parameter.nivel)||1));let html=fuente_('index.html').replace(/<link rel="stylesheet"[^>]+>/,'<style>'+fuente_('estilo.css')+'</style>').replace(/<script src="datos.js[^"]*"><\/script>/,'<script>'+fuente_('datos.js')+'</script>').replace(/<script src="juego.js[^\"]*"><\/script>/,'<script>'+CLASSROOM_BRIDGE+'\n'+REMOTE_GAME+'</script>');html=html.replace('<head>','<head><base target="_top"><script>window.BALAM_WORLD='+w+';</script>');html=html.replace('Sin cuentas, anuncios ni envío de calificaciones. Progreso en este navegador. En equipos compartidos comienza una nueva partida.','Evaluación institucional: resultados en Classroom.').replace('Práctica local. Para registrar tu calificación, abre la tarea Balam · Evaluación en Classroom.','Evaluación institucional · nota base y bono de monedas en Classroom.').replace('href="../"','href="https://script.google.com/a/macros/jaliscoedu.mx/s/AKfycbwDWLhOth-b33H_Ugudxo5X6hXFUEmdK30ZkNNhCQpLuH39ms8O6EydHyJ2Q8EtF4QJ/exec?nivel=6"').replace('href="../numero-secreto.html"','href="https://script.google.com/a/macros/jaliscoedu.mx/s/AKfycbwDWLhOth-b33H_Ugudxo5X6hXFUEmdK30ZkNNhCQpLuH39ms8O6EydHyJ2Q8EtF4QJ/exec?nivel=7"');return HtmlService.createHtmlOutput(html).setTitle('Balam · Evaluación institucional')}catch(err){return HtmlService.createHtmlOutput('<h2>Acceso institucional a Balam</h2><p>'+String(err.message).replace(/[<>&]/g,' ')+'</p><p>Vuelve a abrir el enlace de tu tarea con la cuenta de la escuela.</p>')}}

function calculateGrade_(w,s){s.baseGrade=Math.round(s.records.filter(r=>r.attempts===1).length/totalRetos(w)*10000)/100;s.grade=Math.min(100,Math.round((s.baseGrade+(s.coins||[]).length*5)*100)/100)}
/** Cada moneda es única por alumno y mundo; solo se habilita tras un error real registrado. */
function recogerMoneda(w,id){return locked_(()=>{w=world_(w);if(!Number.isInteger(id)||id<0||id>2)throw Error('Moneda inválida.');const who=identity_(),s=readState_(who,w,'apoyo');if(!s.started&&s.records.length===0&&s.pending.attempts===0)throw Error('Primero inicia la aventura.');const failed=s.records.some(r=>r.attempts>1)||s.pending.attempts-(s.pending.correct?1:0)>0;if(!failed)throw Error('Las monedas de recuperación se habilitan después de un error.');s.coins=s.coins||[];if(!s.coins.includes(id)){if(s.coins.length>=3)throw Error('Ya reuniste tres monedas.');s.coins.push(id);}if(s.done===totalRetos(w)){calculateGrade_(w,s);s.gradeStatus='pending-sync';persist_(who,w,s);try{syncGrade_(who,w,s)}catch(e){s.gradeStatus='pending-sync'}}persist_(who,w,s);return safeState_(s,who)})}

