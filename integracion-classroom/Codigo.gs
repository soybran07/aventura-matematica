e)*.2;if(actors.some(e=>!e.dead&&Math.hypot(e.x-hero.x,e.y-hero.y)<165))action()}hero.x=Math.max(160,Math.min(1120,hero.x+dx*210*dt));hero.y=Math.max(365,Math.min(610,hero.y+dy*210*dt));for(const e of actors){if(e.dead)continue;const d=Math.hypot(hero.x-e.x,hero.y-e.y);e.x+=(hero.x-e.x)/Math.max(1,d)*55*dt;e.y+=(hero.y-e.y)/Math.max(1,d)*55*dt;if(pulse>0&&d<170)e.dead=true;else if(d<39){e.dead=true;hurt()}}if(elapsed>9)arcadeDone();}}\nfunction draw(){Art.background(ctx,game,time);if(phase==='home'){Art.hero(ctx,270,540,2,time,false);Art.hero(ctx,1060,410,1.3,time,false,true);return}if(phase==='bonus'){for(let i=0;i<3;i++){const [x,y]=coinSpots[i];Art.fern(ctx,x+20,y+45,80,'#377554');if(!st.coins.includes(i))Art.coin(ctx,x,y,time)}Art.hero(ctx,380,575,1.4,time);return}if(phase==='finish'){Art.hero(ctx,530,525,1.7,time);Art.hero(ctx,740,525,1.7,time,false,true);return}\nif(phase==='puzzle')drawPuzzle();else if(phase==='arcade')drawArcade();else if(phase==='explore')drawRuins();if(drag?.kind==='fruit')Art.fruit(ctx,pointer.x,pointer.y,1.6);if(drag?.kind==='board')Art.round(ctx,pointer.x-35,pointer.y-10,70,20,4,'#e8c779');}\nfunction drawPuzzle(){const p=problem();if(game===0){Art.round(ctx,78,275,195,140,13,'#976b43');Art.round(ctx,66,262,219,25,6,'#c5a06b');for(let i=0;i<14;i++)Art.fruit(ctx,105+i%5*33,300+Math.floor(i/5)*30,1.2);Art.text(ctx,'ARRASTRA LOS FRUTOS',175,448,14);bagPositions().forEach((b,i)=>Art.bag(ctx,b.x,b.y,b.w,activity.bags[i],activity.selected===i,p.b));Art.hero(ctx,180,575,1.35,time);}\nif(game===1){const g=grid();Art.round(ctx,g.x-30,g.y-28,g.cols*g.size+60,g.rows*g.size+60,18,'#163f4155');for(let r=0;r<g.rows;r++)for(let c=0;c<g.cols;c++){const i=r*g.cols+c,x=g.x+c*g.size,y=g.y+r*g.size;Art.round(ctx,x+3,y+3,g.size-6,g.size-6,6,activity.tiles[i]?'#c7a668':'#d6edcf20');if(activity.tiles[i]){Art.round(ctx,x+6,y+7,g.size-12,3,1,'#f0d995');Art.ellipse(ctx,x+g.size*.3,y+g.size*.5,2,2,'#8a6a43')}}Art.round(ctx,105,330,140,40,6,'#ddbd79');Art.round(ct