nction coinPlaces(){const last=gate(count()-1);return[{id:0,x:gate(0)-240,y:240},{id:1,x:gate(Math.floor(count()/2))+210,y:300},{id:2,x:last+545,y:300},{id:0,x:last+220,y:300},{id:1,x:last+380,y:240}]}\nfunction availableCoins(){return hasError()?coinPlaces().filter(c=>!st.coins.includes(c.id)).sort((a,b)=>a.x-b.x):[]}\nasync function collectCoin(c){if(coinBusy||st.coins.includes(c.id))return;coinBusy=true;try{if(remote)st=await ClassroomLink.coin(world,c.id);else{st.coins.push(c.id);save()}for(let i=0;i<12;i++)particles.push({x:c.x,y:c.y,vx:Math.cos(i)*60,vy:-80-Math.random()*70,life:.7});hud();msg('Moneda maya '+st.coins.length+'/3 · +0.5 sobre 10. Bono máximo: +1.5.')}catch(e){stop();msg(e.message)}finally{coinBusy=false}}\nfunction assist(){if(mode==='play'){motor='asistido';auto=true;msg('Balam te ayuda a saltar. Tú resuelves las puertas.')}}\nfunction step(dt){if(mode!=='play')return;time+=dt;const prevY=player.y;player.inv=Math.max(0,player.inv-dt);player.coyote=player.grounded?.1:Math.max(0,(player.coyote||0)-dt);let dir=(keys.right?1:0)-(keys.left?1:0);\nfor(const e of enemies){if(!e.alive)continue;e.x+=e.dir*(35+world%5*5)*dt;if(e.x<e.base-30||e.x>e.base+30)e.dir*=-1;}\nif(auto){const target=st.done<count()?gate(st.done)-PW-5:end()+40;const recovery=availableCoins().find(c=>c.x>player.x-32&&c.x<target+110);let goal=recovery?recovery.x-PW/2:target;dir=Math.abs(goal-player.x)<6?0:Math.sign(goal-player.x);const gap=gaps().find(g=>g.x>player.x&&g.x-player.x<100),h=hazards().find(h=>h.x>player.x&&h.x-player.x<100),e=enemies[st.done];if(player.grounded&&(gap||h||recovery&&Math.abs(recovery.x-player.x)<160||e?.alive&&e.x-player.x<160&&e.x>player.x-20))jump();if(recovery&&Math.abs(player.x-goal)<45&&player.y<recovery.y+40&&player.y+PH>recovery.y-45)collectCoin(recovery);if(recovery&&Math.abs(player.x-goal)<8&&player.grounded)jump();if(!recovery&&e?.alive&&Math.abs(e.x-player.x)<18&&!player.grounded)dir=0;if(!recovery&&Math.abs(target-player.x)<7){auto=false;dir=0;msg(st.done<count()?'Pulsa Resolver para abrir el desafío.':'¡Luna te espera!');}}\nif(dir)player.face=dir;player.x+=dir*220*dt;player.x=Math.max(12,Math.min(player.x,st.done<count()?gate(st.done)-PW:width()-100));player.vy+=1450*dt;player.y+=player.vy*dt;player.grounded=false;\nfor(const p of platforms())if(player.x+PW>p.x&&player.x<p.x+p.w&&prevY+PH<=p.y+3&&player.y+PH>=p.y&&player.vy>=0){player.y=p.y-PH;player.vy=0;player.grounded=true}\nconst overGap=gaps().some(g=>player.x+PW*.75>g.x&&player.x+PW*.25<g.x+g.w);if(!overGap&&prevY+PH<=FLOOR+10&&player.y+PH>=FLOOR){player.y=FLOOR-PH;player.vy=0;player.grounded=true}if(player.y>540){player.inv=0;hit()}\nfor(const h of hazards())if(player.x+PW>h.x&&player.x<h.x+h.w&&player.y+PH>FLOOR-17&&player.y<FLOOR)hit();\nfor(const e of enemies)if(e.alive&&player.x+PW>e.x+2&&player.x<e.x+e.w-2&&player.y+PH>e.y&&player.y<e.y+e.h){if(player.vy>0&&prevY+PH<e.y+16){e.alive=false;player.y=e.y-PH;player.vy=-310;stomps++;hud();msg('Guardián superado. Busca la siguiente pista.')}else hit()}\nfor(const c of availableCoins())if(Math.abs(player.x+PW/2-c.x)<30&&Math.abs(player.y+PH/2-c.y)<40)collectCoin(c);\nfor(const p of particles){p.life-=dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=180*dt}particles=particles.filter(p=>p.life>0);\nif(st.done===count()&&player.x>end()+35&&!coinBusy)finish();camera=Math.max(0,Math.min(player.x-250,width()-960));}\nfunction gradeNotice(){if(!remote)return 'Práctica local · esta partida no envía una nota.';if(st.teacherPreview)return 'Vista docente · no se generan notas de alumnos.';return st.gradeStatus==='draft-sent'?'Nota enviada a Classroom para revisión.':'Envío pendiente. Pulsa Comprobar envío.'}\nfunction finish(){if(mode==='finish')return;mode='finish';save();const s=score();show('<div class=\"eyebrow\">El rastro llega a casa</div><h2>¡Luna está a salvo!</h2><p class=\"intro\">El mapa, las puertas y tus operaciones llevaron a Balam hasta la pantera.</p><div class=\"score\"><div><small>Matemáticas</small><b>'+s.base.toFixed(2)+'</b></div><div><small>Monedas · '+st.coins.length+'/3</small><b>+'+s.bonus+'</b></div><div><small>Total / 100</small><b>'+s.total.toFixed(2)+'</b></div></div><p id=\"gradeStatus\" class=\"feedback\">'+gradeNotice()+'</p><div class=\"actions\"><button class=\"gold\" id=\"explore\">Volver a explorar</button>'+(remote?'<button id=\"sync\">Comprobar envío</button>':'')+'<button id=\"endmenu\">Elegir aventura</button></div><details><summary>Mi recorrido y cuaderno</summary><table class=\"report\"><tr><th>Reto</th><th>Errores</th><th>Pista</th></tr>'+st.records.map(r=>'<tr><td>'+esc(r.code)+'</td><td>'+r.tries+'</td><td>'+(r.hints?'Sí':'—')+'</td></tr>').join('')+'</table><p>Muestra al profesor cómo resolviste un problema. Cada moneda equivale a +0.5 sobre 10. La nota máxima es 100.</p></details>','Rescate completado');$('endmenu').onclick=menu;$('explore').onclick=()=>{player.x=gate(0)-480;player.y=FLOOR-PH;player.vy=0;resume()};if($('sync'))$('sync').onclick=async()=>{if(busy)return;busy=true;try{st=await ClassroomLink.retry(world);$('gradeStatus').textContent=gradeNotice()}catch(e){$('gradeStatus').textContent=e.message}finally{busy=false}}}\n// Arte original: siluetas orgánicas y capas de selva, sin imágenes externas.\nfunction rr(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}\nfunction ellipse(x,y,rx,ry,c){ctx.fillStyle=c;ctx.beginPath();ctx.ellipse(x,y,Math.abs(rx),Math.abs(ry),0,0,Math.PI*2);ctx.fill()}\nfunction leaf(x,y,size,angle,c){ctx.save();ctx.translate(x,y);ctx.rotate(angle);ctx.fillStyle=c;ctx.beginPath();ctx.moveTo(0,0);ctx.bezierCurveTo(-size*.45,-size*.2,-size*.35,-size*.65,0,-size);ctx.bezierCurveTo(size*.35,-size*.65,size*.45,-size*.2,0,0);ctx.fill();if(size>45){ctx.strokeStyle='#c4dcb222';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(0,-3);ctx.lineTo(0,-size*.82);ctx.stroke()}ctx.restore()}\nfunction foliage(x,y,s,c){for(let j=0;j<7;j++)leaf(x,y,s*(.65+(j%3)*.12),(j-3)*.34,c)}\nfunction jaguar(x,y,scale=1,panther=false){ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);const body=panther?'#283345':'#e4ac52',light=panther?'#506075':'#ffdeb0';ctx.lineCap='round';ctx.strokeStyle=body;ctx.lineWidth=6;ctx.beginPath();ctx.moveTo(30,38);ctx.bezierCurveTo(57,53,49,19,43,30);ctx.stroke();ellipse(19,35,14,17,body);const walk=mode==='play'&&(keys.left||keys.right||auto)&&player.grounded?Math.sin(time*18)*3:0;ellipse(10,50+walk,8,4,body);ellipse(29,50-walk,8,4,body);ellipse(5,9,6,7,body);ellipse(32,9,6,7,body);ellipse(19,21,20,17,body);ellipse(19,29,11,7,light);ellipse(11,20,2.5,3.5,'#243730');ellipse(27,20,2.5,3.5,'#243730');ellipse(19,27,3,2,'#29372e');if(!panther){for(const [a,b]of[[4,22],[34,25],[11,8],[27,9],[10,38],[29,40]])ellipse(a,b,2,2.2,'#755330');rr(1,0,35,5,2,'#416e5c');leaf(10,0,15,-.4,'#82aa73')}else{ctx.fillStyle='#e4c56f';ctx.beginPath();ctx.moveTo(4,5);ctx.lineTo(4,-10);ctx.lineTo(12,-3);ctx.lineTo(20,-15);ctx.lineTo(27,-3);ctx.lineTo(35,-10);ctx.lineTo(33,5);ctx.fill()}ctx.restore()}\nfunction enemyDraw(e){if(!e.alive)return;ellipse(e.x+20,e.y+19,20,12,'#74725a');ellipse(e.x+20,e.y+10,16,12,'#9eac6b');for(const dx of [10,29]){ellipse(e.x+dx,e.y+9,4,5,'#f8edcf');ellipse(e.x+dx+e.dir,e.y+10,1.8,3,'#283d32')}rr(e.x+2,e.y+25,10,5,2,'#384d3c');rr(e.x+28,e.y+25,10,5,2,'#384d3c')}\nfunction templeAt(x){rr(x-22,222,30,180,6,'#75897e');rr(x+89,222,30,180,6,'#75897e');rr(x-35,207,166,24,7,'#a2b09a');ctx.fillStyle='#536d60';ctx.beginPath();ctx.moveTo(x-42,207);ctx.lineTo(x+49,155);ctx.lineTo(x+140,207);ctx.fill();rr(x+8,231,82,171,40,'#173c35')}\nfunction draw(){const idx=Math.min(count()-1,st.done),night=Math.floor(idx/count()*6)===2||world===4;const sky=ctx.createLinearGradient(0,0,0,480);sky.addColorStop(0,night?'#152b38':'#a6cfb7');sky.addColorStop(1,night?'#497467':'#e0e9bb');ctx.fillStyle=sky;ctx.fillRect(0,0,960,480);ellipse(765-camera*.025,76,night?29:48,night?29:48,night?'#e6e4bf':'#f1f2cf');\nfor(let layer=0;layer<3;layer++){const pace=[.1,.22,.4][layer],colors=night?['#25423f','#264e47','#28574a']:['#8db69b','#6a9d81','#41785f'];for(let i=-1;i<8;i++){const x=i*190-(camera*pace)%190;ctx.strokeStyle=colors[layer];ctx.lineWidth=12+layer*5;ctx.beginPath();ctx.moveTo(x,420);ctx.bezierCurveTo(x-12,270,x+18,90,x+50,0);ctx.stroke();foliage(x+35,130,65+layer*12,colors[layer]);if(layer===2)foliage(x-10,400,100,colors[layer]);} }\n// Brume et perspective du sol.\nconst mist=ctx.createLinearGradient(0,240,0,400);mist.addColorStop(0,'#cce6bc00');mist.addColorStop(1,night?'#9bc8a422':'#ddedb788');ctx.fillStyle=mist;ctx.fillRect(0,230,960,180);\nctx.save();ctx.translate(-camera,0);let start=0;for(const g of [...gaps(),{x:width(),w:0}]){rr(start,FLOOR,g.x-start,90,0,night?'#243f37':'#3c6445');rr(start,FLOOR,g.x-start,7,3,'#93b772');start=g.x+g.w}\nfor(const p of platforms()){if(p.x<camera-150||p.x>camera+1050)continue;rr(p.x,p.y,p.w,12,6,'#63775b');rr(p.x+3,p.y,p.w-6,4,2,'#accb84');ctx.strokeStyle='#6d9271';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(p.x+15,p.y+12);ctx.quadraticCurveTo(p.x+18,p.y+40,p.x+9,p.y+52);ctx.stroke()}\nfor(const h of hazards()){ctx.fillStyle='#aebf86';ctx.beginPath();ctx.moveTo(h.x,FLOOR);ctx.lineTo(h.x+15,FLOOR-21);ctx.lineTo(h.x+h.w,FLOOR);ctx.fill()}\nfor(let i=0;i<count();i++){const x=gate(i);if(x<camera-180||x>camera+1100)continue;templeAt(x);if(i<st.done){ctx.globalAlpha=.45;rr(x+12,235,74,167,36,'#9dc19b');ctx.globalAlpha=1;}else{ellipse(x+49,280,10,14,'#d8c47d');ctx.strokeStyle='#e6d59a';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x+49,295);ctx.lineTo(x+49,308);ctx.stroke()}ctx.font='600 11px system-ui';ctx.textAlign='center';ctx.fillStyle='#f3edd3';ctx.fillText(i<st.done?'PISTA RECUPERADA':'PUERTA '+(i+1),x+49,194);ctx.textAlign='left';}\nfor(const e of enemies)enemyDraw(e);\nfor(const c of coinPlaces()){if(c.x<camera-100||c.x>camera+1060)continue;foliage(c.x+10,c.y+44,48,'#4a7958');if(hasError()&&!st.coins.includes(c.id)){const bob=Math.sin(time*3+c.id)*3;ellipse(c.x,c.y+bob,13,15,'#ebcd73');ellipse(c.x,c.y+bob,8,10,'#c69c44');ctx.fillStyle='#ffeab4';ctx.font='bold 13px serif';ctx.textAlign='center';ctx.fillText('✦',c.x,c.y+5+bob);ctx.textAlign='left';}}\nconst s=end();templeAt(s-40);jaguar(s+1,FLOOR-PH,1,true);if(st.done<count()){ctx.strokeStyle='#9dac94';ctx.lineWidth=4;for(let i=0;i<3;i++){ctx.beginPath();ctx.moveTo(s-18+i*27,252);ctx.lineTo(s-18+i*27,FLOOR);ctx.stroke()}}\nctx.save();if(player.inv>0&&Math.floor(time*9)%2)ctx.globalAlpha=.55;ctx.translate(player.x+(player.face<0?PW:0),player.y);ctx.scale(player.face,1);jaguar(0,0);if(night){rr(36,12,5,29,2,'#92744f');ellipse(38,6+Math.sin(time*15)*2,6,11,'#f7ca76');ellipse(38,8,3,6,'#fff0b2')}ctx.restore();for(const p of particles)ellipse(p.x,p.y,2,2,'#f7dda0');ctx.restore();\nif(night){const light=ctx.createRadialGradient(player.x-camera+38,player.y+12,20,player.x-camera+38,player.y+12,235);light.addColorStop(0,'#06172000');light.addColorStop(1,'#061720aa');ctx.fillStyle=light;ctx.fillRect(0,0,960,480)}\n// Feuillage au premier plan, loin des zones de collision.\nfor(const x of [-30,980])foliage(x,470,105,'#133e32');for(const x of [25,180,880]){leaf(x,-5,90,Math.PI*.88,'#204c39');leaf(x+40,-5,100,-Math.PI*.88,'#2d5e41')}\nctx.fillStyle=night?'#f2e4c2':'#254b3c';ctx.font='600 12px system-ui';ctx.fillText(scene(idx).toUpperCase(),25,35);}\nfunction loop(t){const dt=Math.min((t-last)/1000||0,.03);last=t;step(dt);draw();requestAnimationFrame(loop)}\nwindow.addEventListener('keydown',e=>{if(e.key==='Tab'&&mode!=='play'){const els=[...$('card').querySelectorAll('button:not([disabled]):not(.hide),input:not([disabled]),select:not([disabled]),summary')].filter(x=>x.offsetParent!==null);if(!els.length)return;if(e.shiftKey&&document.activeElement===els[0]){e.preventDefault();els.at(-1).focus()}else if(!e.shiftKey&&document.activeElement===els.at(-1)){e.preventDefault();els[0].focus()}return}if(mode!=='play')return;const k=e.key.toLowerCase();if(['arrowleft','arrowright','arrowup',' ','a','d','e'].includes(k))e.preventDefault();if(k==='arrowleft'||k==='a'){keys.left=true;auto=false}if(k==='arrowright'||k==='d'){keys.right=true;auto=false}if((k===' '||k==='arrowup')&&!e.repeat)jump();if(k==='e'&&!e.repeat)interact();if(k==='escape')menu()});window.addEventListener('keyup',e=>{const k=e.key.toLowerCase();if(['arrowleft','a'].includes(k))keys.left=false;if(['arrowright','d'].includes(k))keys.right=false});window.addEventListener('blur',()=>{stop();save()});document.addEventListener('visibilitychange',()=>{if(document.hidden){stop();save()}});\nfor(const [id,dir]of[['left','left'],['right','right']]){$(id).addEventListener('pointerdown',e=>{e.preventDefault();$(id).setPointerCapture(e.pointerId);if(mode==='play'){keys[dir]=true;auto=false}});for(const type of ['pointerup','pointercancel','lostpointercapture'])$(id).addEventListener(type,()=>keys[dir]=false)}$('jump').onclick=jump;$('action').onclick=interact;$('menu').onclick=()=>{if(!busy&&!coinBusy)menu()};$('assist').onclick=assist;\nload();menu();requestAnimationFrame(loop);\n";

