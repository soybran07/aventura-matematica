const REMOTE_GAME = "'use strict';\nconst $=id=>document.getElementById(id),canvas=$('game'),ctx=canvas.getContext('2d');\nconst FLOOR=402,PW=38,PH=54,SPACE=620,KEY='balam-aventura-v3',remote=!!window.ClassroomLink;\nconst requested=Number(window.BALAM_WORLD||window.BALAM_START||new URLSearchParams(location.search).get('nivel')||1);\nlet world=Math.min(6,Math.max(0,requested-1)),route='apoyo',motor='normal',catalog={},st,player,enemies,mode='menu',keys={left:false,right:false},auto=false,last=0,time=0,camera=0,stomps=0,solved=false,busy=false,coinBusy=false,particles=[],checkpoint=70;\nif(!remote)try{catalog=JSON.parse(localStorage.getItem(KEY)||'{}')}catch{}\nconst count=()=>totalRetos(world),gate=i=>570+i*SPACE,end=()=>gate(count()-1)+760,width=()=>end()+370;\nconst esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nfunction fresh(){return{done:0,records:[],pending:{tries:0,hints:0},coins:[],started:false}}\nfunction save(){if(!remote){catalog[world+'-'+route]=st;try{localStorage.setItem(KEY,JSON.stringify(catalog))}catch{}}}\nfunction load(){const old=catalog[world+'-'+route];st=old&&old.done<=count()?old:fresh();st.coins=st.coins||[];spawn();hud()}\nfunction spawn(){checkpoint=st.done?gate(st.done-1)+92:70;player={x:checkpoint,y:FLOOR-PH,vy:0,grounded:false,face:1,inv:2};enemies=Array.from({length:count()},(_,i)=>({x:gate(i)-60,base:gate(i)-60,y:FLOOR-30,w:40,h:30,dir:i%2?1:-1,alive:i>=st.done}));stomps=st.done;camera=Math.max(0,player.x-230)}\nfunction msg(t){if($('message').textContent!==t)$('message').textContent=t}\nfunction stop(){keys.left=keys.right=false;auto=false}\nfunction score(){const base=Math.round(st.records.filter(r=>r.tries===0).length/count()*10000)/100;return{base,bonus:st.coins.length*5,total:Math.min(100,Math.round((base+st.coins.length*5)*100)/100)}}\nfunction hasError(){return st.pending.tries>0||st.records.some(r=>r.tries>0)}\nfunction hud(){$('worldTitle').textContent=WORLDS[world].title;$('chapter').textContent=(world>=5?'JUEGO '+(world-4):'SUMAS Y RESTAS '+(world+1))+' · '+WORLDS[world].topic;$('seals').textContent=st.done+' / '+count()+' pistas';$('stats').textContent=st.coins.length+' / 3 monedas mayas · '+stomps+' guardianes';document.title=WORLDS[world].title+' · Balam'}\nfunction show(html,label){stop();$('overlay').classList.remove('hide');$('card').className='card '+(mode==='problem'?'problem-card':'');$('card').innerHTML=html;$('card').setAttribute('aria-label',label);$('card').querySelector('input,button,select')?.focus()}\nfunction resume(){stop();mode='play';$('overlay').classList.add('hide');canvas.focus();msg(st.done===count()?'Busca las monedas entre las hojas o llega a Luna.':'Explora y salta. Pulsa E junto al siguiente arco.');}\nfunction selectedWorld(i){save();world=i;route=rutas(world).includes(route)?route:'apoyo';load();menu()}\nfunction menu(){mode='menu';save();const order=[5,6,0,1,2,3,4];show('<div class=\"eyebrow\">BALAM · EL RASTRO DE LUNA</div><h2>Una pista.<br>Un salto más cerca.</h2><p class=\"intro\">Cruza la selva y el Templo de la Noche. Resuelve cada puerta para descubrir dónde está la pantera.</p><div class=\"worlds\">'+order.map(i=>'<button class=\"world '+(i===world?'active':'')+'\" data-world=\"'+i+'\"><small>'+(i>=5?'JUEGO '+(i-4):'SUMAS Y RESTAS '+(i+1))+'</small><b>'+esc(WORLDS[i].title)+'</b></button>').join('')+'</div><div class=\"settings\"><label>Matemáticas<select id=\"route\">'+rutas(world).map(r=>'<option value=\"'+r+'\" '+(route===r?'selected':'')+'>'+({apoyo:'Con apoyo',practica:'Práctica',reto:'Reto'}[r])+'</option>').join('')+'</select></label><label>Movimiento<select id=\"motor\"><option value=\"normal\" '+(motor==='normal'?'selected':'')+'>Manual</option><option value=\"asistido\" '+(motor==='asistido'?'selected':'')+'>Con ayuda</option></select></label></div><div class=\"actions\"><button class=\"gold\" id=\"start\">'+(st.started?'Continuar aventura':'Seguir el rastro')+'</button>'+