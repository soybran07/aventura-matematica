nst s=score();show('<div class=\"eyebrow\">El rastro llega a casa</div><h2>¡Luna está a salvo!</h2><p class=\"intro\">El mapa, las puertas y tus operaciones llevaron a Balam hasta la pantera.</p><div class=\"score\"><div><small>Matemáticas</small><b>'+s.base.toFixed(2)+'</b></div><div><small>Monedas · '+st.coins.length+'/3</small><b>+'+s.bonus+'</b></div><div><small>Total / 100</small><b>'+s.total.toFixed(2)+'</b></div></div><p id=\"gradeStatus\" class=\"feedback\">'+gradeNotice()+'</p><div class=\"actions\"><button class=\"gold\" id=\"explore\">Volver a explorar</button>'+(remote?'<button id=\"sync\">Comprobar envío</button>':'')+'<button id=\"endmenu\">Elegir aventura</button></div><details><summary>Mi recorrido y cuaderno</summary><table class=\"report\"><tr><th>Reto</th><th>Errores</th><th>Pista</th></tr>'+st.records.map(r=>'<tr><td>'+esc(r.code)+'</td><td>'+r.tries+'</td><td>'+(r.hints?'Sí':'—')+'</td></tr>').join('')+'</table><p>Muestra al profesor cómo resolviste un problema. Cada moneda equivale a +0.5 sobre 10. La nota máxima es 100.</p></details>','Rescate completado');$('endmenu').onclick=menu;$('explore').onclick=()=>{player.x=gate(0)-480;player.y=FLOOR-PH;player.vy=0;resume()};if($('sync'))$('sync').onclick=async()=>{if(busy)return;busy=true;try{st=await ClassroomLink.retry(world);$('gradeStatus').textContent=gradeNotice()}catch(e){$('gradeStatus').textContent=e.message}finally{busy=false}}}\n// Arte original: siluetas orgánicas y capas de selva, sin imágenes externas.\nfunction rr(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}\nfunction ellipse(x,y,rx,ry,c){ctx.fillStyle=c;ctx.beginPath();ctx.ellipse(x,y,Math.abs(rx),Math.abs(ry),0,0,Math.PI*2);ctx.fill()}\nfunction leaf(x,y,size,angle,c){ctx.save();ctx.translate(x,y);ctx.rotate(angle);ctx.fillStyle=c;ctx.beginPath();ctx.moveTo(0,0);ctx.bezierCurveTo(-size*.45,-size*.2,-size*.35,-size*.65,0,-size);ctx.bezierCurveTo(size*.35,-size*.65,size*.45,-size*.2,0,0);ctx.fill();