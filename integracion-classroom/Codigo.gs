const MULT_DATA = "'use strict';\nconst MUL_GAMES=[\n{title:'El campamento de las provisiones',short:'Campamento',tag:'AGRUPA Y REPARTE',theme:'camp',goal:'Forma grupos iguales y relaciona suma repetida con multiplicación.',story:'La expedición de Luna necesita provisiones. Prepara las mochilas de sus exploradores.',controls:'Arrastra frutos a las mochilas. También puedes elegir una mochila y usar los botones.',color:'#dfb96b'},\n{title:'El puente de los guardianes',short:'El puente',tag:'CONSTRUYE Y CRUZA',theme:'bridge',goal:'Construye filas y columnas y reconoce que cambiar el orden de los factores conserva el total.',story:'El río separa a Balam de la siguiente pista. Construye un puente con filas y columnas de tablones.',controls:'Arrastra el tablón a la cuadrícula o toca las casillas. Al cruzar: flechas y espacio para saltar.',color:'#8ad8d0'},\n{title:'Las vagonetas del templo',short:'Vagonetas',tag:'CALCULA Y CONDUCE',theme:'mine',goal:'Interpreta cargas iguales como suma repetida y encuentra factores que faltan.',story:'Las vías del templo llevan hasta Luna. Calcula la carga y elige el desvío correcto.',controls:'Elige una vía cuando el tren se detenga. En movimiento cambia de carril para evitar rocas.',color:'#bea0e4'},\n{title:'La defensa del santuario',short:'El santuario',tag:'PIENSA Y PROTEGE',theme:'defense',goal:'Construye las tablas usando resultados conocidos: dobles, grupos de 5 y grupos de 10.',story:'Los guardianes de sombra rodean el santuario. Las multiplicaciones cargan el escudo de Balam.',controls:'Las preguntas pausan el ataque. Después muévete con flechas o WASD y usa espacio o Escudo.',color:'#adc875'},\n{title:'El rescate entre las ruinas',short:'Las ruinas',tag:'EXPLORA Y RESCATA',theme:'ruins',goal:'Identifica la operación de un problema y explica el resultado con su unidad.',story:'Luna dejó seis pistas entre las ruinas. Resuelve sus desafíos para abrir el último portal.',controls:'Explora con flechas o WASD. Acércate al portal luminoso para investigar.',color:'#ebaa79'}\n];\nconst MUL_FACTORS=[[[2,3],[3,2],[4,3],[3,4],[5,2],[4,4]],[[2,4],[3,3],[3,5],[4,4],[4,5],[5,6]],[[3,4],[4,5],[5,3],[6,4],[4,6],[6,5]],[[2,4],[5,3],[10,2],[4,5],[6,3],[8,4]],[[3,4],[4,3],[5,4],[3,6],[4,5],[5,6]]];\nfunction mulProblem(game,index,route){const base=MUL_FACTORS[game][index];let a=base[0],b=base[1];if(route==='practica'){a+=game===3?0:2;b+=game===3?2:1;}const common={game,index,a,b,answer:a*b,unit:'',kind:'mul',check:null,code:'M'+(game+1)+'-'+route[0].toUpperCase()+'-'+String(index+1).padStart(2,'0')};\nif(game===0)return{...common,kind:'camp',unit:'frutos',story:`Hay ${a} exploradores. Cada mochila debe llevar ${b} frutos. Prepara todas las mochilas y calcula cuántos frutos necesita la expedición.`,hint:`Coloca ${b} frutos en cada una de las ${a} mochilas. Suma ${Array(a).fill(b).join(' + ')} o escribe ${a} × ${b}.`,explain:`${a} grupos de ${b}: ${Array(a).fill(b).join(' + ')} = ${a} × ${b} = ${a*b} frutos.`};\nif(game===1)return{...common,kind:'array',unit:'tablones',story:`Construye ${a} filas con ${b} tablones por fila. ¿Cuántos tablones forman el puente?`,hint:`Completa una fila de ${b}; luego repítela ${a} veces. Girar la cuadrícula cambia filas por columnas, pero no el total.`,explain:`${a} filas × ${b} columnas = ${a*b} tablones. También ${b} × ${a} = ${a*b}.`};\nif(game===2){const missing=index===2||index===5;return{...common,kind:'rail',missing,answer:missing?a:a*b,unit:missing?'vagones':'cristales',story:missing?`El tren lleva ${a*b} cristales. Cada vagón transporta ${b}. ¿Cuántos vagones necesita? Elige la vía con ese número.`:`Hay ${a} vagones con ${b} cristales cada uno. ¿Cuántos cristales lleva el tren? Elige la vía correcta.`,hint:missing?`Busca qué número por ${b} da ${a*b}. Puedes agrupar los cristales de ${b} en ${b}.`:`Suma ${b} una vez por cada vagón: ${a} × ${b}.`,explain:missing?`${a*b} cristales en grupos de ${b}: ${a} vagones; ${a} × ${b} = ${a*b}.`:`${a} × ${b} = ${a*b} cristales.`};}\nif(game===3)return{...common,unit:'energías',story:index<3?`Cada columna del santuario necesita ${b} energías. Hay ${a} columnas. ¿Cuántas energías cargan el escudo?`:`Balam conoce 5 × ${b} = ${5*b}. Usa ese dato para encontrar ${a} × ${b}. ¿Cuántas energías obtiene?`,hint:a>=5?`Descompón ${a} × ${b} como 5 × ${b} ${a>=5?'+':'−'} ${Math.abs(a-5)} × ${b}.`:`Puedes dibujar ${a} grupos de ${b} o usar un doble conocido.`,explain:`${a} × ${b} = ${a*b} energías. Los resultados conocidos ayudan a construir otros.`};\nconst extra=index===5?b:0;const stories=[`Cada uno de ${a} exploradores necesita ${b} metros de cuerda. ¿Cuántos metros deben reunir?`,`Hay ${a} refugios; cada uno necesita ${b} lámparas. ¿Cuántas lámparas hay que llevar?`,`Luna dejó ${a} cajas con ${b} vendas en cada una. ¿Cuántas vendas hay?`,`Balam compra ${a} paquetes de semillas. Cada paquete cuesta ${b} monedas. ¿Cuánto paga?`,`Hay ${a} equipos con ${b} exploradores por equipo. ¿Cuántos exploradores participan?`,`Hay ${a} canastas con ${b} frutos cada una y ${extra} frutos sueltos. ¿Cuántos frutos hay en total?`];const units=['metros','lámparas','vendas','monedas','exploradores','frutos'];return{...common,kind:'word',extra,answer:a*b+extra,operation:extra?'muladd':'mul',unit:units[index],story:stories[index],hint:extra?`Primero reúne las canastas: ${a} × ${b}. Después añade los ${extra} frutos sueltos.`:`La cantidad por grupo se repite ${a} veces. Representa los grupos y busca el total.`,explain:`${a} × ${b}${extra?' + '+extra:''} = ${a*b+extra} ${units[index]}.`};}\nfunction mulValid(p,v,c){if(!Number.isInteger(v)||v<0)return false;if(p.kind==='camp')return Array.isArray(c)&&c.length===p.a&&c.every(n=>Number.isInteger(n)&&n>=0&&n<=20);if(p.kind==='array')return c&&Number.isInteger(c.rows)&&Number.isInteger(c.cols)&&Number.isInteger(c.placed);if(p.kind==='word')return ['mul','add','sub','muladd'].includes(c);return c===null||c===undefined;}\nfunction mulCorrect(p,v,c){if(v!==p.answer)return false;if(p.k