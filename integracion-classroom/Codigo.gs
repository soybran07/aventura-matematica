WORLDS.push({title:'El templo de los números',topic:'Unidades, decenas, centenas y millares',goal:'Construir, comparar y reagrupar sin cambiar el valor.',palette:['#c0ddd1','#e1efd5','#254c3f','#78ad70']},{title:'La ruta del número secreto',topic:'Construye, cambia y compara',goal:'Leer posiciones, usar el cero y comparar cantidades.',palette:['#8dbba8','#d8e8cb','#264d43','#80ae70']});
function totalRetos(w){return w===5?10:w===6?8:6}
function rutas(w){return w>=5?['apoyo','practica','reto']:['apoyo','practica']}
function getProblem(w,i,r){if(w<5)return arithmeticProblem(w,i,r);const p=w===5?missions(r)[i]:challenges(r)[i];return {...p,story:(p.story||p.context)+' '+p.q,unit:'',check:null,code:(w===5?'VP':'NS')+'-'+r[0].toUpperCase()+'-'+String(i+1).padStart(2,'0')};}
function respuestaValida(p,v,c){if(p.kind==='build')return Array.isArray(v)&&v.length===p.digits.length&&v.every(n=>Number.isInteger(n)&&n>=0&&n<=9);if(p.kind==='compare')return ['A','B','igual'].includes(v);return Number.isInteger(v)&&v>=0&&(p.check===null||p.check===undefined||Number.isInteger(c)&&c>=0)}
function respuestaCorrecta(p,v,c){return p.kind==='build'?v.every((n,i)=>n===p.digits[i]):v===p.answer&&(p.check===null||p.check===undefined||c===p.check)}

