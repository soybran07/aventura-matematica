function calc(tokens){let i=0;function part(){if(tokens[i]==='('){i++;const v=sum();if(tokens[i++]!==')')throw Error('Paréntesis');return v}const v=tokens[i++];if(!Number.isInteger(v))throw Error('Número');return v}function sum(){let v=part();while(i<tokens.length&&tokens[i]!==')'){const op=tokens[i++],n=part();if(op==='+')v+=n;else if(op==='-')v-=n;else throw Error('Operación')}return v}const result=sum();if(i!==tokens.length)throw Error('Expresión');return result}
function getProblem(world,index,route){const w=WORLDS[world],p=w.problems[index],easy=route==='apoyo';let expr,story,unit;if(w.mixed){expr=easy?p.easy:p.expr;unit=p.unit;story=p.story;if(easy){const n=expr.filter(Number.isInteger);const stories=[`Balam reúne ${n[0]} frutos, recibe ${n[1]} y entrega ${n[2]}. ¿Cuántos conserva?`,`Balam lleva ${n[0]} monedas y paga ${n[1]} y luego ${n[2]}. ¿Cuántas quedan?`,`Se necesitan ${n[0]} semillas; hay ${n[1]} y llegan ${n[2]}. ¿Cuántas faltan?`,`Hay ${n[0]} litros y llegan ${n[1]}; se usan ${n[2]}. ¿Cuántos quedan?`,`Balam lleva ${n[0]} gemas, pierde ${n[1]} y encuentra ${n[2]}. ¿Cuántas lleva ahora?`,`Se necesitan ${n[0]} ladrillos; hay ${n[1]}, llegan ${n[2]} y se rompen ${n[3]}. ¿Cuántos faltan?`];story=stories[index]}}else{expr=easy?[p[4],p[5],p[6]]:[p[1],p[2],p[3]];unit=p[7];story=easy?(expr[1]==='+'?`Balam tiene ${expr[0]} ${unit} y recibe ${expr[2]} más. ¿Cuántos tiene ahora?`:`Balam tiene ${expr[0]} ${unit} y utiliza ${expr[2]}. ¿Cuántos quedan?`):p[0]}
const answer=calc(expr);let check=world===3?answer+expr[2]:null;return{story,expr,answer,unit,check,hint:w.hint,explain:expr.join(' ')+' = '+answer+' '+unit+(check!==null?'. Comprobación: '+answer+' + '+expr[2]+' = '+check:'.'),code:'SR'+(world+1)+'-'+route[0].toUpperCase()+'-'+String(index+1).padStart(2,'0')}}

const CLASSROOM_BRIDGE = "const ClassroomLink = {\n call(name,args){return new Promise((resolve,reject)=>{google.script.run.withSuccessHandler(resolve).withFailureHandler(e=>reject(new Error(e.message||'No se pudo conectar. Intenta de nuevo.')))[name](...args)})},\n begin(w,r){return this.call('iniciarJuego',[w,r])},\n answer(w,r,i,v,c){return this.call('registrarRespuesta',[w,r,i,v,c])},\n hint(w,r,i){return this.call('usarPista',[w,r,i])},\n advance(w,r,i){return this.call('avanzarReto',[w,r,i])},\n retry(w){return this.call('reenviarCalificacion',[w])}\n};\nwindow.ClassroomLink=ClassroomLink;\n";
const REMOTE_GAME = "'use strict';\nconst $=id=>document.getElementById(id),canvas=$('game'),ctx=canvas.getContext('2d');\nconst W=3900,H=480,FLOOR=390,PW=44,PH=62,COUNT=6,KEY='balam-sumas-v1';\nconst requested=Number(window.BALAM_WORLD||new URLSearchParams(location.search).get('nivel'));\nlet world=Number.isInteger(requested)&&requested>=1&&requested<=5?requested-1:0,route='apoyo',motor='normal',catalog={};\n// La evaluación recupera el progreso del servidor, nunca el de otro usuario local.\nlet st,player,enemy,mode='menu',keys={left:false,right:false},auto=false,last=0,time=0,camera=0,stomps=0,solved=false;\nfunction gate(i){return 560+i*520}\nfunction spawn(){player={x:st.done?gate(st.done-1)+100:60,y:FLOOR-PH,vy:0,face:1,inv:1};makeEnemies()}\nfunction fresh(){return{done:0,records:[],pending:{tries:0,hints:0},started:false}}\nfunction valid(s){return s&&Number.isInteger(s.done)&&s.done>=0&&s.done<=6&&Array.isArray(s.records)&&s.records.length===s.done}\nfunction load(){const old=catalog[world+'-'+route];st=valid(old)?old:fresh();if(!st.pending)st.pending={tries:0,hints:0};spawn();updateHud()}\nfunction save(){if(window.ClassroomLink)return;if(!st)return;catalog[world+'-'+route]=st;try{localStorage.setItem(KEY,JSON.stringify(catalog))}catch{}}\nfunction stop(){keys.left=keys.right=false;auto=false}\nfunction msg(text){if($('message').textContent!==text)$('message').textContent=text}\nfunction makeEnemies(){enemy=Array.from({length:6},(_,i)=>({x:gate(i)-180,y:FLOOR-33,w:46,h:33,base:gate(i)-180,dir:i%2?1:-1,alive:i>=st.done,squash:0}));stomps=st.done}\nfunction updateHud(){$('worldTitle').textContent=WORLDS[world].title;$('chapter').textContent='MUNDO '+(world+1)+' · '+WORLDS[world].topic;$('seals').textContent=st.done+' / 6 llaves';$('stats').textContent=stomps+' enemigos aplastados';document.title=WORLDS[world].topic+' · Balam y la pantera'}\nfunction show(html,label){stop();$('overlay').classList.remove('hide');$('card').className='card'+(label.startsWith('Reto de ')?' problem-card':'');$('card').innerHTML=html;$('card').setAttribute('aria-label',label);const first=$('card').querySelector('button,input,select');if(first)first.focus()}\nfunction resume(){stop();$('overlay').classList.add('hide');mode='play';canvas.focus();msg(st.done===6?'¡Seis llaves! Llega al santuario de Luna.':'Avanza, salta sobre el enemigo y resuelve el reto de la puerta '+(st.done+1)+'.');}\nfunction menu(){mode='menu';save();show('<div class=\"eyebrow\">Una aventura de plataformas · Cinco juegos</div><h2>Balam y el rescate<br>de la pantera Luna</h2><p class=\"intro\">Explora cinco mundos. Salta para aplastar a los guardianes de fantasía, reúne seis llaves resolviendo problemas y libera a Luna al final de cada mundo. Los errores matemáticos permiten reintentar sin castigos.</p><div class=\"worlds\">'+WORLDS.map((w,i)=>'<button class=\"world '+(i===world?'active':'')+'\" data-world=\"'+i+'\" aria-pressed=\"'+(i===world)+'\"><b>'+(i+1)+'. '+w.topic+'</b><small>'+w.title+'</small></button>').join('')+'</div><div class=\"settings\"><label>Ruta de matemáticas<select id=\"route\"><option value=\"apoyo\" '+(route==='apoyo'?'selected':'')+'>Con apoyo · cantidades menores</option><option value=\"practica\" '+(route==='practica'?'selected':'')+'>Práctica · cantidades mayores</option></select></label><label>Movimiento<select id=\"motor\"><option value=\"normal\" '+(motor==='normal'?'selected':'')+'>Manual · flechas y salto</option><option value=\"asistido\" '+(motor==='asistido'?'selected':'')+'>Asistido · caminar y saltar con ayuda</option></select></label></div><div class=\"note\"><b>Objetivo de este mundo</b>'+WORLDS[world].goal+'<br>Antes de responder: clave de misión, datos, procedimiento y respuesta en el cuaderno.</div><div class=\"actions\"><button class=\"gold\" id=\"start\">'+(st.started?'Continuar mundo':'Comenzar mundo')+'</button>'+''+'</div><p class=\"small\">Movimiento manual: ← → o A/D; espacio para saltar; E para resolver. En modo asistido usa Avanzar con ayuda; los problemas los resuelves tú. No hay cronómetro ni límite de intentos.</p><details><summary>Para el profesor</summary>Hay seis retos por mundo y dos rutas académicas: 60 variantes en total. Separa habilidades motrices y matemáticas usando movimiento asistido. Revisa el cuaderno; los enemigos no determinan la calificación. En el mundo 4 se exige también la comprobación por suma; en el 5 se resuelven situaciones de varios pasos. La identidad se verifica con la cuenta institucional y la inscripción a la clase. Los aciertos al primer intento determinan la nota; las pistas se registran aparte. El profesor revisa la calificación en Classroom. Cinco juegos con un motor compartido y contenidos diferentes.</details>','Menú de los cinco mundos');\n$('card').querySelectorAll('[data-world]').forEach(b=>b.onclick=()=>{save();world=Number(b.dataset.world);history.replaceState(null,'','?nivel='+(world+1));load();menu()});$('route').onchange=e=>{save();route=e.target.value;load();menu()};$('motor').onchange=e=>motor=e.target.value;\n$('start').onclick=async()=>{const button=$('start');button.disabled=true;button.textContent='Verificando tu cuenta…';try{motor=$('motor').value;st=await ClassroomLink.begin(world,route);route=st.route;spawn();updateHud();if(st.done===6)finish();else resume()}catch(err){menu();const p=document.createElement('p');p.className='feedback warn';p.textContent=err.message;$('card').appendChild(p)}};if($('reset'))$('reset').onclick=()=>{show('<h2>¿Nueva partida?</h2><p>Esto reemplaza únicamente el avance del mundo '+(world+1)+' en la ruta '+route+'. Los demás mundos y rutas se conservan.</p><div class=\"actions\"><button class=\"gold\" id=\"yesreset\">Sí, reiniciar esta ruta</button><button id=\"noreset\">Conservar avance</button></div>','Confirmar nueva partida');$('yesreset').onclick=()=>{st=fresh();save();spawn();updateHud();menu()};$('noreset').onclick=menu}}\nfunction jump(){if(mode==='play'&&player.grounded){player.vy=-600;player.grounded=false}}\nfunction hit(e){if(player.inv>0)return;player.x=st.done?gate(st.done-1)+100:60;player.y=FLOOR-PH;player.vy=0;player.inv=1.8;auto=false;stop();msg('¡Cuidado con el costado! Vuelves al punto de control. Tus llaves se conservan; salta para caer encima o usa movimiento asistido.')}\nfunction stomp(e){e.alive=false;e.squash=.6;player.vy=-250;stomps++;updateHud();msg('¡Enemigo aplastado! Acércate a la puerta y pulsa Resolver o E.');}\nfunction interact(){if(mode!=='play')return;if(st.done===6){msg('Camina al santuario para rescatar a Luna.');return}if(Math.abs(player.x-(gate(st.done)-PW))>125){msg('Primero acércate a la siguiente puerta.');return}if(enemy[st.done].alive){msg('El guardián sigue aquí. Salta y cae encima; o activa Avanzar con ayuda.');return}problem()}\nfunction worked(p){if(world===0)return 'Ejemplo distinto: 23 + 14 → 2 D + 1 D y 3 U + 4 U = 37. Para 46 − 12, retira por columnas: 34.';if(world===1)return 'Ejemplo distinto: 27 + 15. 7 U + 5 U = 12 U = 1 D + 2 U. 2 D + 1 D + 1 D = 4 D. Total: 42.';if(world===2)return 'Ejemplo distinto: 54 − 28. Cambia 1 decena: 54 = 4 D + 14 U. Retira 2 D y 8 U. Quedan 26.';if(world===3)return 'Ejemplo distinto: 100 − 36. Reagrupa 100 como 9 D y 10 U. Retira 3 D y 6 U: quedan 64. Comprueba: 64 + 36 = 100.';return 'Ejemplo distinto: hay 30 frutos, llegan 12 y se entregan 8. Primero 30 + 12 = 42; después 42 − 8 = 34. La respuesta es 34 frutos.'}\nfunction problem(){mode='problem';solved=false;const p=getProblem(world,st.done,route);let extra='';if(world===3)extra='<label>Comprobación: resultado + cantidad retirada<input id=\"checkvalue\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"Total inicial\"></label>';\n\nshow('<div class=\"eyebrow\">Mundo '+(world+1)+' · Reto '+(st.done+1)+' de 6</div><h2>'+WORLDS[world].topic+'</h2><p class=\"question\">'+p.story+'</p><form id=\"form\"><div class=\"answer\"><label>Tu respuesta en '+p.unit+'<input id=\"answer\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"Escribe aquí\"></label>'+extra+'</div><div class=\"actions primary-actions\"><button class=\"gold\" type=\"submit\" id=\"verify\">Comprobar</button><button type=\"button\" id=\"hintbutton\">Pedir pista</button></div></form><div id=\"feedback\" role=\"status\" aria-live=\"polite\"></div><div id=\"hint\" class=\"hint hide\"></div><details class=\"notebook-help\"><summary>Cuaderno y ejemplo de apoyo</summary><p><b>'+p.code+'</b> · Anota datos, procedimiento y respuesta con unidad antes de contestar.</p><p>'+worked(p)+'</p></details><div class=\"actions bottom-actions\"><button class=\"gold hide\" id=\"unlock\">Tomar llave y abrir puerta</button><button id=\"back\">Volver al camino</button></div>','Reto de '+WORLDS[world].topic);\n$('hintbutton').onclick=async()=>{try{const result=await ClassroomLink.hint(world,route,st.done);st.pending=result.state.pending;$('hint').textContent=result.hint;$('hint').classList.remove('hide')}catch(err){feedback(err.message,false)}};$('back').onclick=()=>{save();resume()};\n$('form').onsubmit=async e=>{e.preventDefault();if(solved)return;const v=$('answer').value.trim(),cv=world===3?$('checkvalue').value.trim():null;if(!/^\\d+$/.test(v)||(world===3&&!/^\\d+$/.test(cv))){feedback('Escribe tu respuesta con números enteros, sin comas ni puntos.',false);return}let ok=false;$('verify').disabled=true;try{const result=await ClassroomLink.answer(world,route,st.done,Number(v),world===3?Number(cv):null);ok=result.correct;st.pending=result.state.pending}catch(err){feedback(err.message,false);$('verify').disabled=false;return}$('verify').disabled=false;if(!ok){feedback(world===3?'Revisa el resultado y la comprobación: al sumar lo que quedó más lo retirado debes recuperar la cantidad inicial.':world===4?'Revisa cada paso de la historia y comprueba las operaciones. Puedes pedir una pista.':'Revisa las columnas y los cambios de decenas o centenas. Puedes pedir una pista y volver a intentar.',false);return}solved=true;feedback('¡Llave recuperada! '+p.explain,true);$('verify').disabled=true;$('hintbutton').disabled=true;$('card').querySelectorAll('input,select').forEach(x=>x.disabled=true);$('unlock').classList.remove('hide');$('back').classList.add('hide')};\n$('unlock').onclick=async()=>{if(!solved)return;$('unlock').disabled=true;try{st=await ClassroomLink.advance(world,route,st.done);player.x=gate(st.done-1)+80;player.y=FLOOR-PH;player.vy=0;updateHud();resume()}catch(err){feedback(err.message,false);$('unlock').disabled=false}}}\nfunction feedback(text,ok){$('feedback').textContent=text;$('feedback').className='feedback'+(ok?'':' warn')}\nfunction finish(){if(mode==='finish')return;mode='finish';save();const independent=st.records.filter(x=>x.tries===0&&!x.hints).length;show('<div class=\"feedback\">'+gradeNotice(st)+'</div><div class=\"eyebrow\">Santuario liberado · Mundo '+(world+1)+'</div><h2>¡Luna está a salvo!</h2><p class=\"intro\">El jaguar y la pantera recuperaron el santuario de '+WORLDS[world].title.toLowerCase()+'. Resolviste seis retos de '+WORLDS[world].topic.toLowerCase()+'.</p><div class=\"note\"><b>Comparte lo aprendido</b>Muestra el cuaderno y explica un procedimiento. ¿Qué cambiaste de lugar o de agrupación? ¿Cómo comprobaste una respuesta? Tus habilidades de movimiento no determinan lo que sabes de matemáticas.</div><p class=\"small\">'+independent+' retos sin errores ni pistas; '+(6-independent)+' con práctica o apoyo. La calificación sobre 100 se envía como borrador al profesor.</p><table class=\"report\"><thead><tr><th>Reto</th><th>Intentos incorrectos</th><th>Pista</th></tr></thead><tbody>'+st.records.map(r=>'<tr><td>'+r.code+'</td><td>'+r.tries+'</td><td>'+(r.hints?'Sí':'No')+'</td></tr>').join('')+'</tbody></table><div class=\"actions\"><button id=\"nextworld\" class=\"gold\">'+(world<4?'Ir al siguiente mundo':'Elegir otro mundo')+'</button><button id=\"print\">Imprimir recorrido</button><button id=\"sync\">Comprobar envío</button><button id=\"endmenu\">Menú</button></div><p class=\"small\">Resultado asociado a tu cuenta institucional. El profesor revisa la nota en Classroom.</p>','Rescate completado');$('nextworld').onclick=()=>{if(world<4)world++;history.replaceState(null,'','?nivel='+(world+1));load();menu()};$('sync').onclick=async()=>{try{st=await ClassroomLink.retry(world);mode='menu';finish()}catch(err){const p=document.createElement('p');p.className='feedback warn';p.textContent=err.message;$('card').appendChild(p)}};$('endmenu').onclick=menu;$('print').onclick=()=>window.print()}\n// Plataformas laterales opcionales: el camino principal permanece transitable.\nfunction platforms(){return Array.from({length:6},(_,i)=>({x:gate(i)-420,y:315-(i%2)*24,w:95,h:18}))}\nfunction step(dt){if(mode!=='play')return;time+=dt;const prevY=player.y;let dir=(keys.right?1:0)-(keys.left?1:0);player.inv=Math.max(0,player.inv-dt);\nfor(const e of enemy){e.squash=Math.max(0,e.squash-dt);if(!e.alive)continue;e.x+=e.dir*(world===3?34:world===4?43:26)*dt;if(e.x<e.base-32){e.x=e.base-32;e.dir=1}if(e.x>e.base+32){e.x=e.base+32;e.dir=-1}}\nif(auto){const e=enemy[st.done];if(e&&e.alive){const distance=(e.x+e.w/2)-(player.x+PW/2);if(player.grounded&&distance<170&&distance>30)jump();if(!player.grounded&&Math.abs(distance)<13)dir=0;else dir=Math.sign(distance);if(distance<0&&player.grounded)dir=-1}else{const target=st.done<6?gate(st.done)-PW-4:3650;if(Math.abs(target-player.x)<7){auto=false;dir=0;msg(st.done<6?'Llegaste. Pulsa Resolver para abrir el reto.':'Luna te espera en el santuario.')}else dir=Math.sign(target-player.x)}}\nif(dir)player.face=dir;player.x+=dir*190*dt;player.x=Math.max(10,Math.min(player.x,st.done<6?gate(st.done)-PW:W-100));player.vy+=1400*dt;player.y+=player.vy*dt;player.grounded=false;\nfor(const p of platforms()){if(player.x+PW>p.x&&player.x<p.x+p.w&&prevY+PH<=p.y+3&&player.y+PH>=p.y&&player.vy>=0){player.y=p.y-PH;player.vy=0;player.grounded=true}}\nif(player.y+PH>=FLOOR){player.y=FLOOR-PH;player.vy=0;player.grounded=true}\nfor(const e of enemy){if(!e.alive)continue;if(player.x+PW>e.x+3&&player.x<e.x+e.w-3&&player.y+PH>e.y&&player.y<e.y+e.h){if(player.vy>0&&prevY+PH<=e.y+12){player.y=e.y-PH;stomp(e)}else hit(e)}}\nif(st.done===6&&player.x>3560)finish();camera=Math.max(0,Math.min(player.x-240,W-960))}\n// Todo el arte se dibuja localmente, sin imágenes externas.\nfunction rr(x,y,w,h,r,color){ctx.fillStyle=color;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}\nfunction ellipse(x,y,rx,ry,color){ctx.fillStyle=color;ctx.beginPath();ctx.ellipse(x,y,rx,ry,0,0,Math.PI*2);ctx.fill()}\nfunction jaguar(x,y,scale=1,panther=false){ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);const body=panther?'#29323e':'#edb04b',light=panther?'#5d6470':'#ffe0a1';ctx.lineCap='round';ctx.strokeStyle=body;ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(32,43);ctx.bezierCurveTo(63,58,52,22,44,36);ctx.stroke();ellipse(22,43,17,19,body);const walk=mode==='play'&&(keys.left||keys.right||auto)&&player.grounded?Math.sin(time*19)*3:0;ellipse(12,59+walk,9,5,body);ellipse(33,59-walk,9,5,body);ellipse(7,13,7,8,body);ellipse(36,13,7,8,body);ellipse(22,26,23,20,body);ellipse(22,34,13,9,light);ellipse(13,25,2.7,4,panther?'#a9e9a0':'#253b31');ellipse(31,25,2.7,4,panther?'#a9e9a0':'#253b31');ellipse(22,32,3.5,2.5,'#232b2a');ctx.strokeStyle='#24312c';ctx.lineWidth=1.4;ctx.beginPath();ctx.moveTo(22,34);ctx.lineTo(22,38);ctx.stroke();if(!panther){for(const [a,b]of[[5,29],[39,31],[14,12],[30,13],[12,45],[31,48]])ellipse(a,b,2,2.5,'#705335');rr(3,3,37,7,2,'#477058');ellipse(22,3,14,7,'#93a775');rr(17,-1,10,5,1,'#f3d978')}else{ctx.fillStyle='#f4d16c';ctx.beginPath();ctx.moveTo(7,10);ctx.lineTo(5,-7);ctx.lineTo(16,0);ctx.lineTo(22,-11);ctx.lineTo(29,0);ctx.lineTo(39,-7);ctx.lineTo(36,10);ctx.closePath();ctx.fill();ellipse(22,3,3,3,'#ad8bd8')}ctx.restore()}\nfunction enemyDraw(e,i){if(!e.alive&&e.squash<=0)return;ctx.save();ctx.translate(e.x,e.y+(e.alive?0:23));ctx.scale(1,e.alive?1:.25);const colors=['#824f87','#4b8fbd','#9c795f','#ad6f39','#6d5793'];ellipse(23,18,24,18,colors[world]);rr(2,20,10,14,4,'#344543');rr(33,20,10,14,4,'#344543');ellipse(14,11,5,7,'#fff5db');ellipse(31,11,5,7,'#fff5db');ellipse(14+(e.dir>0?1:-1),12,2.4,4,'#233b37');ellipse(31+(e.dir>0?1:-1),12,2.4,4,'#233b37');ctx.strokeStyle='#263a33';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(18,24);ctx.lineTo(27,24);ctx.stroke();if(world===3){ctx.beginPath();ctx.moveTo(40,20);ctx.quadraticCurveTo(68,10,53,-8);ctx.stroke()}if(world===2){ctx.strokeStyle='#d1b79a';ctx.beginPath();ctx.moveTo(5,12);ctx.lineTo(18,2);ctx.lineTo(30,10);ctx.stroke()}ctx.restore()}\nfunction draw(){const pal=WORLDS[world].palette;const sky=ctx.createLinearGradient(0,0,0,390);sky.addColorStop(0,pal[0]);sky.addColorStop(1,pal[1]);ctx.fillStyle=sky;ctx.fillRect(0,0,960,480);ellipse(800-camera*.04,83,40,40,world===4?'#e1d8cf':'#fff1ba');for(let i=-1;i<6;i++){const x=i*270-(camera*.18)%270;ctx.fillStyle=pal[2]+'60';ctx.beginPath();ctx.moveTo(x,390);ctx.lineTo(x+140,135+(i%2)*60);ctx.lineTo(x+330,390);ctx.fill()}\nctx.save();ctx.translate(-camera,0);for(let i=0;i<18;i++){const x=i*240+80;if(x<camera-150||x>camera+1100)continue;if(world===3){rr(x,240,18,150,6,'#8d985d');rr(x-25,290,30,12,5,'#8d985d');rr(x-28,258,12,40,4,'#8d985d')}else{rr(x,220,18,170,6,pal[2]);ellipse(x+5,210,70,32,pal[2]);ellipse(x-28,188,39,25,pal[2]);ellipse(x+42,184,43,27,pal[2])}}\nrr(0,FLOOR,W,90,0,pal[2]);rr(0,FLOOR,W,10,0,pal[3]);ctx.fillStyle='#ffffff16';for(let i=0;i<W;i+=42)ctx.fillRect(i,425,15,7);\nfor(const p of platforms()){rr(p.x,p.y,p.w,p.h,4,'#bea678');rr(p.x,p.y,p.w,5,2,'#e3ce95');ellipse(p.x+45,p.y-21,7,10,'#f4ce62')}\nfor(let i=0;i<6;i++){const x=gate(i);if(x<camera-120||x>camera+1100)continue;rr(x-8,180,28,210,3,'#b0b28a');rr(x+88,180,28,210,3,'#b0b28a');rr(x-14,166,136,28,4,'#d6cda0');if(i>=st.done){rr(x+20,198,66,192,3,'#36544ae0');ctx.fillStyle='#efce6e';ctx.font='bold 28px system-ui';ctx.fillText('?',x+44,270)}rr(x-25,125,155,28,5,'#244e43');ctx.fillStyle='#f5efd1';ctx.font='bold 12px system-ui';ctx.textAlign='center';ctx.fillText(i<st.done?'✓ Puerta abierta':'Reto '+(i+1)+' · '+(enemy[i].alive?'Guardián':'Resolver'),x+53,144);ctx.textAlign='left'}\nfor(let i=0;i<6;i++)enemyDraw(enemy[i],i);\n// Santuario y princesa pantera, presentes en cada mundo.\nrr(3500,190,230,200,4,'#8c91a0');rr(3480,175,270,25,4,'#b6b6ba');for(let i=0;i<5;i++)rr(3480+i*58,150,35,30,2,'#b6b6ba');rr(3560,250,112,140,40,'#343f50');jaguar(3590,316,1.13,true);if(st.done<6){ctx.strokeStyle='#c5c6bc';ctx.lineWidth=5;for(let i=0;i<4;i++){ctx.beginPath();ctx.moveTo(3570+i*28,254);ctx.lineTo(3570+i*28,390);ctx.stroke()}}else{ctx.fillStyle='#f6d57b';ctx.font='18px system-ui';ctx.fillText('♥',3610,305)}\nctx.save();if(player.inv>0&&Math.floor(time*10)%2)ctx.globalAlpha=.5;ctx.translate(player.x+(player.face<0?PW:0),player.y);ctx.scale(player.face,1);jaguar(0,0);ctx.restore();ctx.restore()}\nfunction loop(t){const dt=Math.min((t-last)/1000||0,.03);last=t;step(dt);draw();requestAnimationFrame(loop)}\nwindow.addEventListener('keydown',e=>{if(e.key==='Tab'&&mode!=='play'){const focusable=[...$('card').querySelectorAll('button:not([disabled]),input:not([disabled]),select:not([disabled]),summary')];if(focusable.length){const a=focusable[0],b=focusable[focusable.length-1];if(e.shiftKey&&document.activeElement===a){e.preventDefault();b.focus()}else if(!e.shiftKey&&document.activeElement===b){e.preventDefault();a.focus()}}return}if(mode!=='play')return;const k=e.key.toLowerCase();if(['arrowleft','arrowright','a','d',' ','e'].includes(k))e.preventDefault();if(k==='arrowleft'||k==='a'){keys.left=true;auto=false}if(k==='arrowright'||k==='d'){keys.right=true;auto=false}if(k===' '&&!e.repeat)jump();if(k==='e'&&!e.repeat)interact();if(k==='escape')menu()});window.addEventListener('keyup',e=>{const k=e.key.toLowerCase();if(k==='arrowleft'||k==='a')keys.left=false;if(k==='arrowright'||k==='d')keys.right=false});window.addEventListener('blur',()=>{stop();save()});document.addEventListener('visibilitychange',()=>{if(document.hidden){stop();save()}});\nfor(const [id,dir]of[['left','left'],['right','right']]){$(id).addEventListener('pointerdown',e=>{e.preventDefault();$(id).setPointerCapture(e.pointerId);if(mode==='play'){keys[dir]=true;auto=false}});for(const type of ['pointerup','pointercancel','lostpointercapture'])$(id).addEventListener(type,()=>keys[dir]=false)}$('jump').onclick=jump;$('action').onclick=interact;$('menu').onclick=menu;$('assist').onclick=()=>{if(mode==='play'){motor='asistido';auto=true;msg('Balam camina y salta con ayuda. Tú resolverás el problema al llegar.')}};\nfunction gradeNotice(s){if(s.teacherPreview)return 'Vista docente: esta prueba no registra notas de alumnos.';if(s.gradeStatus==='draft-sent')return 'Resultado: '+s.grade+'/100. Enviado a Classroom para revisión del profesor.';return 'Resultado: '+s.grade+'/100. Aún no se ha confirmado el envío. Usa Comprobar envío.'}load();menu();requestAnimationFrame(loop);\n";

