a'];\nfunction scene(i){return scenes[Math.min(5,Math.floor(i/count()*6))]}\nfunction clue(i){const clues=['Una huella de Luna apunta hacia el río.','En las raíces hay una pluma: conduce al Templo de la Noche.','La antorcha revela un mapa. Luna está más allá de la galería.','El eco de la pantera viene del sendero lunar.','Una última huella lleva al santuario.','La puerta final se abre. ¡Luna te espera!'];return clues[Math.min(5,Math.floor((i+1)/count()*6))]}\nfunction storyIntro(){return 'Balam llegó a '+scene(st.done).toLowerCase()+'. Su meta es rescatar a Luna. Para abrir esta puerta y encontrar otra pista, necesita resolver el desafío.'}\nfunction problem(){mode='problem';solved=false;const p=getProblem(world,st.done,route);let inputs='';if(p.kind==='build'){const cols=p.digits.length===4?['UM','C','D','U']:['C','D','U'];inputs=cols.map((s,i)=>'<label>'+s+'<input id=\"digit'+i+'\" inputmode=\"numeric\" maxlength=\"1\" aria-label=\"'+s+'\"></label>').join('')}else if(p.kind==='compare'){inputs='<label>Tu elección<select id=\"answer\"><option value=\"\">Elige…</option><option value=\"A\">Sendero / reserva A</option><option value=\"B\">Sendero / reserva B</option><option value=\"igual\">La misma cantidad</option></select></label>'}else{inputs='<label>Tu respuesta'+(p.unit?' en '+esc(p.unit):'')+'<input id=\"answer\" inputmode=\"numeric\" autocomplete=\"off\" placeholder=\"Escribe aquí\"></label>';if(p.check!==null&&p.check!==undefined)inputs+='<label>Comprobación: resultado + cantidad retirada<input id=\"checkvalue\" inputmode=\"numeric\" placeholder=\"Total inicial\"></label>'}\nshow('<div class=\"eyebrow\">'+esc(scene(st.done))+' · '+(st.done+1)+' / '+count()+'</div><h2>'+esc(p.title||WORLDS[world].topic)+'</h2><p class=\"question\">'+esc(p.story)+'</p><form id=\"form\"><div class=\"answer '+(p.kind==='build'?'digits':'')+'\">'+inputs+'</div><div class=\"actions\"><button class=\"gold\" id=\"verify\" type=\"submit\">Abrir la puerta</button><button type=\"button\" id=\"hintbutton\">Pista</button></div></form><div id=\"feedback\" role=\"status\"></div><div id=\"hint\" class=\"hint hide\"></div><details><summary>Historia y cuaderno</summary><p>'+esc(storyIntro())+'</p><p>'+esc(p.code)+' · Escribe datos, operaciones y respuesta antes de contestar.</p></details><div class=\"actions\"><button id=\"unlock\" class=\"gold hide\">Recoger pista y seguir</button><button id=\"back\" type=\"button\">Volver al camino</button></div>','Reto de '+WORLDS[world].topic);\n$('back').onclick=()=>{if(!busy)resume()};$('hintbutton').onclick=async()=>{if(busy)return;busy=true;try{let hint=p.hint;if(remote){const res=await ClassroomLink.hint(world,route,st.done);st=res.state;hint=res.hint;}else{st.pending.hints=1;save()}$('hint').textContent=hint;$('hint').classList.remove('hide')}catch(e){feedback(e.message,false)}finally{busy=false}};\n$('form').onsubmit=async e=>{e.preventDefault();if(busy||solved)return;let v,c=null;if(p.kind==='build'){const raw=p.digits.map((_,i)=>$('digit'+i).value.trim());if(raw.some(x=>!/^\\d$/.test(x))){feedback('Escribe una cifra en cada posición.',false);return}v=raw.map(Number)}else if(p.kind==='compare'){v=$('answer').value;}else{const raw=$('answer').value.trim(),check=$('checkvalue')?.value.trim();if(!/^\\d+$/.test(raw)||(p.check!==null&&p.check!==undefined&&!/^\\d+$/.test(check||''))){feedback('Escribe números enteros sin separadores.',false);return}v=Number(raw);if(check!==undefined)c=Number(check)}if(!respuestaValida(p,v,c)){feedback('Completa tu respuesta.',false);return}busy=true;$('verify').disabled=true;try{let ok;if(remote){const res=await ClassroomLink.answer(world,route,st.done,v,c);ok=res.correct;st=res.state;}else{ok=respuestaCorrecta(p,v,c);if(!ok)st.pending.tries++;save()}if(!ok){feedback('Revisa y vuelve a intentar. Al explorar, busca los tres escondites de monedas mayas para recuperar puntos.',false);hud();return}solved=true;feedback(p.explain+' '+clue(st.done),true);$('hintbutton').disabled=true;$('car