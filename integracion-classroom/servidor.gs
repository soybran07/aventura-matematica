/** Crea solo las cinco tareas nuevas de la sección 03. */
function configurarMultiplicacion(){const email=owner_();props_().setProperty('OWNER',email);const tasks=JSON.parse(props_().getProperty('TASKS')||'{}'),existing=list_('courses/'+BALAM_CONFIG.courseId+'/courseWork','courseWork'),topic={topicId:'895575401239'};for(let g=0;g<5;g++){const w=g+7;if(tasks[w])continue;const title='03 · Multiplicación '+(g+1)+'/5 · '+MUL_GAMES[g].title;const found=existing.find(x=>x.title===title&&x.associatedWithDeveloper),body={title,description:'Expedición de multiplicación. Completa seis desafíos con tu correo institucional y conserva tus procedimientos en el cuaderno.',workType:'ASSIGNMENT',state:'DRAFT',maxPoints:100};if(topic)body.topicId=topic.topicId;const task=found||api_('courses/'+BALAM_CONFIG.courseId+'/courseWork','post',body);tasks[w]=task.id;props_().setProperty('TASKS',JSON.stringify(tasks));}console.log('Cinco tareas de multiplicación listas en borrador, sin modificar las secciones anteriores.');return tasks}
function publicarMultiplicacion(){owner_();const tasks=JSON.parse(props_().getProperty('TASKS')||'{}');for(let g=0;g<5;g++){const w=g+7;if(!tasks[w])throw Error('Primero ejecuta configurarMultiplicacion.');api_('courses/'+BALAM_CONFIG.courseId+'/courseWork/'+tasks[w]+'?updateMask=state,description','patch',{state:'PUBLISHED',description:'JUGAR Y REGISTRAR CALIFICACIÓN: '+MUL_APP_URL+'?nivel='+(w+1)+'\n\n'+MUL_GAMES[g].story+'\n\n'+MUL_GAMES[g].goal+'\n\n'+MUL_GAMES[g].controls+'\n\nEntra con tu correo institucional inscrito en esta clase. Completa seis desafíos. En el cuaderno: clave de misión, representación o datos, operación y respuesta con unidad.\n\nNota base sobre 100 = aciertos al primer intento / 6 × 100. Si te equivocas, podrás explorar tres escondites de monedas mayas. Cada moneda suma +0.5 sobre 10 (+5/100), máximo +15/100 y nota total máxima de 100. Los corazones y movimientos no restan puntos de matemáticas. Las preguntas no tienen cronómetro y pausan la acción. Hay controles alternativos y movimiento con ayuda. Espera el mensaje de envío a Classroom. La nota se guarda como borrador para revisión del profesor.'});}console.log('Cinco tareas de multiplicación publicadas en la sección 03.');}
function fuenteMultiplicacion_(file){const cache=CacheService.getScriptCache(),key='mul:'+MUL_REF+':'+file,hit=cache.get(key);if(hit)return hit;const r=UrlFetchApp.fetch('https://raw.githubusercontent.com/'+BALAM_CONFIG.repo+'/'+MUL_REF+'/multiplicacion/'+file,{muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('No se pudo cargar la expedición. Vuelve a intentar.');const text=r.getContentText();if(text.length<90000)cache.put(key,text,600);return text;}
function doGetMultiplicacion_(e,who){try{const w=Number(e.parameter.nivel);if(!Number.isInteger(w)||w<8||w>12)throw Error('Aventura inválida.');let html=fuenteMultiplicacion_('index.html').replace(/<script src="..\/ruta.js[^"]*"><\/script>/,()=>'<script>'+RUTA_CLIENT+'</script>').replace(/<link rel="stylesheet"[^>]+>/,()=>'<style>'+fuenteMultiplicacion_('estilo.css')+'</style>').replace(/<script src="datos.js"><\/script>/,()=>'<script>'+MULT_DATA+'</script>').replace(/<script src="arte.js"><\/script>/,()=>'<script>'+MULT_ART+'</script>').replace(/<script src="juego.js[^"]*"><\/script>/,()=>'<script>'+CLASSROOM_BRIDGE+'\n'+MULT_GAME+'</script>');html=html.replace('<head>','<head><base target="_top"><script>window.BALAM_APP='+JSON.stringify(MUL_APP_URL)+';window.BALAM_RESUME='+JSON.stringify(dificultadGuardada_(who,w-1))+';window.BALAM_WORLD='+w+';</script>').replace('href="./"','href="'+MUL_APP_URL+'?nivel='+w+'"').replace('href="../"','href="'+MUL_APP_URL+'?nivel=6"').replace('href="../sumas/"','href="'+MUL_APP_URL+'?nivel=1"');return HtmlService.createHtmlOutput(html).setTitle('Balam · Multiplicación institucional')}catch(err){return HtmlService.createHtmlOutput('<h2>Acceso institucional a Balam</h2><p>'+String(err.message).replace(/[<>&]/g,' ')+'</p><p>Abre tu tarea con la cuenta institucional inscrita en la clase.</p>')}}

function iniciarHuidaTemplo(){return locked_(()=>{const who=identity_(),s=readState_(who,5,'apoyo');if(s.done!==9)throw Error('Primero cruza el río de lava.');const ms=(s.route==='apoyo'?24:s.route==='reto'?12:18)*1000;s.huidaHasta=Date.now()+ms;persist_(who,5,s);return ms;});}

/** Reinicia solo la vista privada del docente. No modifica entregas. */
function reiniciarTemploDocente(){return locked_(()=>{const who=identity_();if(!who.teacher)throw Error('Solo disponible en la vista docente.');const w=5,route=dificultadGuardada_(who,w)||'apoyo';props_().deleteProperty(stateKey_(who,w));const s=readState_(who,w,route);persist_(who,w,s);return safeState_(s,who);});}
